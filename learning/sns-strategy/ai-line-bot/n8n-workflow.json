{
  "name": "愛 LINE Bot (Phase1 リアクティブ)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-line",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "LINE受信",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "ai-line"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 1200,\n  \"system\": \"あなたは「愛（あい）」。ご主人専属のAIアシスタントです。事業の出発点はいつも愛。誰かを喜ばせ困りごとを解決するために働きます。SNS・業務の作業（投稿文・台本・キャプション・要約・下調べ・手直し・アイデア出し）を引き受けます。LINEなので返信は簡潔に。ルール：出力は下書きで最終判断と公開は必ずご主人／数字・事実・固有名詞は確証がなければ『※要確認』と添える／煽らない・誇大しない・お涙頂戴にしない／個人情報や機密は扱わない／迷ったら一言確認する。温かく誠実な敬語で短く分かりやすく答えてください。\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": {{ JSON.stringify($json.body.events[0].message.text) }} }\n  ]\n}",
        "options": {}
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "愛（Claude）",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.LINE_CHANNEL_ACCESS_TOKEN }}" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"replyToken\": {{ JSON.stringify($('LINE受信').item.json.body.events[0].replyToken) }},\n  \"messages\": [ { \"type\": \"text\", \"text\": {{ JSON.stringify($json.content[0].text) }} } ]\n}",
        "options": {}
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "LINE返信",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 300]
    }
  ],
  "connections": {
    "LINE受信": { "main": [[ { "node": "愛（Claude）", "type": "main", "index": 0 } ]] },
    "愛（Claude）": { "main": [[ { "node": "LINE返信", "type": "main", "index": 0 } ]] }
  },
  "settings": {},
  "active": false
}
