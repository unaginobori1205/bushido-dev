# ============================================================
# voice-claude 設定ファイル
# コピーして .env を作り、値を書き換えてください:
#   cp .env.example .env
#
# .env はここに秘密鍵を書くファイルです。絶対にコミットしないでください
# (.gitignore で除外済みです)。
# ============================================================

# --- OpenAI ---------------------------------------------------
# Realtime API が有効なプロジェクトのAPIキー。
# ★重要: このキーをチャット・Slack・Issueなど、どこであれ他人に見える
#   場所に貼り付けた場合、そのキーは漏洩したものとして扱い、
#   OpenAIダッシュボード (https://platform.openai.com/api-keys) で
#   直ちに Revoke（失効） し、新しいキーを発行してください。
OPENAI_API_KEY=sk-...

# 使用する音声モデル / 声質 / 言語
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_LANGUAGE=ja

# 発話の区切り検出方式: semantic_vad (推奨・意味的に自然な間で区切る) / server_vad
TURN_DETECTION_TYPE=semantic_vad

# 音声AIが喋り終わってから、マイクを再開するまでの待機時間(ms)。
# スピーカーの反響/エコーを拾ってしまうのを防ぐための余白。
POST_SPEECH_MUTE_MS=800

# --- Claude Code ------------------------------------------------
# claude コマンドのパス（PATHが通っていれば "claude" のままでOK）
CLAUDE_BIN=claude

# Claude Code を実行するディレクトリ。空なら voice-claude を起動した
# カレントディレクトリになります。「普段使っているプロジェクト」の
# ディレクトリを指定してください。
CLAUDE_CWD=

# `claude -p` に渡す追加オプション（スペース区切り）。
# 例: 承認プロンプトなしでファイル編集まで自動で行わせたい場合:
#   CLAUDE_EXTRA_ARGS=--permission-mode acceptEdits
# ⚠️ 音声入力には「確認」のステップがありません。信頼できる/隔離された
#   プロジェクトでのみ権限を緩めてください。既定値（空）は最も安全です。
CLAUDE_EXTRA_ARGS=

# Claude Codeの応答を待つ最大時間(ms)。長い作業をさせる場合は伸ばしてください。
CLAUDE_TIMEOUT_MS=600000

# 起動のたびに前回のセッションを引き継がず、新規会話にしたい場合は 1 に。
CLAUDE_FRESH_SESSION=0

# --- 音声入出力 ---------------------------------------------------
# 録音/再生に使う sox コマンドのパス（要インストール）
SOX_BIN=sox
