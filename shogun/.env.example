# ============================================================
# SHOGUN — root environment file
#
# Copy to .env and fill in real values:
#   cp .env.example .env
# Never commit .env — only .env.example (no real values) is tracked.
#
# For a cloud deployment (docs/DEPLOYMENT.md), don't put real values in
# any .env file at all — set them as platform secrets (`fly secrets set`,
# etc.) instead. This file is for local dev.
# ============================================================

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Realtime voice — see ai/openai/realtimeClient.ts / docs/ARCHITECTURE.md §6
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_LANGUAGE=ja
TURN_DETECTION_TYPE=semantic_vad
# "barge-in" (default, matches the product vision) or "mute-while-speaking"
# (for external speakers with no echo cancellation) — see ARCHITECTURE.md §6.
INTERRUPTION_MODE=barge-in
POST_SPEECH_MUTE_MS=800

DATABASE_URL=./database/shogun.sqlite

SHOGUN_USER_NAME=
SHOGUN_TIMEZONE=Asia/Tokyo

# --- core/orchestrator's local WebSocket server -----------------------
# Local dev (default): loopback-only, no token needed — nothing outside
# this machine can reach it.
CORE_WS_PORT=8787
CORE_WS_HOST=127.0.0.1
CORE_AUTH_TOKEN=
# --- ai/claude (Claude Code delegation, MVP0.3) -----------------------
# Off by default: the conversation loop is safe by construction, but
# delegation runs commands on this machine. Turn it on deliberately.
CLAUDE_DELEGATION_ENABLED=false
CLAUDE_BIN=claude
# Where delegated tasks run. Empty = wherever you started `pnpm dev:core`.
# Point this at ONE project or scratch directory — a voice command has no
# confirmation step and no undo (docs/SECURITY.md).
CLAUDE_CWD=
# Extra flags for `claude -p`. Empty means Claude Code declines anything it
# would normally prompt about, which is the safe default. Loosening it
# (e.g. "--permission-mode acceptEdits") is itself a Level 2/3 decision.
CLAUDE_EXTRA_ARGS=
CLAUDE_TIMEOUT_MS=600000
# Where the per-project Claude session ids are remembered, so
# "continue yesterday's work" resumes the same conversation.
# Empty = ~/.shogun/claude-sessions.json
CLAUDE_SESSION_FILE=
# ASK BEFORE ACT: read the task back and require a spoken yes before
# running it. Setting false swaps per-task confirmation for standing
# consent — only with CLAUDE_CWD pointed somewhere disposable.
CLAUDE_REQUIRE_CONFIRMATION=true

# Cloud deployment (docs/DEPLOYMENT.md) instead sets:
#   CORE_WS_HOST=0.0.0.0
#   CORE_AUTH_TOKEN=<a long random value — see docs/DEPLOYMENT.md>
# core/orchestrator/auth.ts refuses to start with a non-loopback host and
# no token, so this isn't something you can forget silently.
