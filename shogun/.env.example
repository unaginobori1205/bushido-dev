# ============================================================
# SHOGUN — root environment file (design placeholder)
#
# This is the top-level env surface described in the product spec (§21).
# Module-specific env files (e.g. ai/claude/.env.example) may still exist
# for standalone/dev use of that module until everything is wired through
# a single root config loader in core/context.
#
# Copy to .env and fill in real values once MVP0.1 implementation starts.
# Never commit .env — only .env.example (no real values) is tracked.
# ============================================================

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

DATABASE_URL=./database/shogun.sqlite

SHOGUN_USER_NAME=
SHOGUN_TIMEZONE=Asia/Tokyo
